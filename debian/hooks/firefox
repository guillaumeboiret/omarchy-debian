#!/bin/bash
# Debian port: theme Firefox like the rest of Omarchy (it has no Omarchy template).
# Installed into ~/.config/omarchy/hooks/{theme-set,font-set}.d/. Writes userChrome.css +
# userContent.css into every Firefox profile: current theme colors, Omarchy font, square corners.
# Firefox reads these at startup, so the new theme shows after a Firefox restart.

colors="$HOME/.local/state/omarchy/current/theme/colors.toml"
ff="$HOME/.mozilla/firefox"
[[ -f $colors && -f $ff/profiles.ini ]] || exit 0

c() { sed -nE "s/^$1[[:space:]]*=[[:space:]]*\"(#[0-9a-fA-F]{6})\".*/\1/p" "$colors" | head -1; }
bg=$(c background) bg_dark=$(c dark_background) bg_darker=$(c darker_background) bg_light=$(c lighter_background)
fg=$(c foreground) fg_light=$(c light_foreground) muted=$(c muted) accent=$(c accent) sel=$(c selection) red=$(c red)
mode=$(sed -nE 's/^mode[[:space:]]*=[[:space:]]*"([a-z]+)".*/\1/p' "$colors")
[[ -n $bg && -n $fg && -n $accent ]] || exit 0
: "${bg_dark:=$bg}" "${bg_darker:=$bg_dark}" "${bg_light:=$bg}" "${fg_light:=$fg}" "${muted:=$fg_light}" "${sel:=$bg_light}" "${red:=$accent}"
scheme=${mode:-dark}
font=$(omarchy-font-current 2>/dev/null); font=${font:-monospace}

read -r -d '' vars <<EOF
  --om-bg: $bg; --om-bg-dark: $bg_dark; --om-bg-darker: $bg_darker; --om-bg-light: $bg_light;
  --om-fg: $fg; --om-fg-light: $fg_light; --om-muted: $muted; --om-accent: $accent;
  --om-sel: $sel; --om-red: $red; --om-font: "$font";
EOF

read -r -d '' square <<'EOF'
  --border-radius-xsmall: 0px !important; --border-radius-small: 0px !important;
  --border-radius-medium: 0px !important; --border-radius-large: 0px !important;
  --border-radius-xlarge: 0px !important; --border-radius-circle: 0px !important;
  --tab-border-radius: 0px !important; --toolbarbutton-border-radius: 0px !important;
  --urlbar-icon-border-radius: 0px !important; --arrowpanel-border-radius: 0px !important;
  --panel-border-radius: 0px !important; --button-border-radius: 0px !important;
  --tab-block-margin: 0px !important;
EOF

chrome_css=$(cat <<EOF
/* Generated by Omarchy (debian/hooks/firefox) — rewritten on every theme/font change. Edit the hook, not this file. */
:root, :root[lwtheme], #navigator-toolbox, #nav-bar, #TabsToolbar, #urlbar, #sidebar-box, menupopup, panel {
$vars
$square
  color-scheme: $scheme !important;
  --lwt-accent-color: var(--om-bg-darker) !important;
  --lwt-text-color: var(--om-fg) !important;
  --toolbox-bgcolor: var(--om-bg-darker) !important;
  --toolbox-textcolor: var(--om-fg) !important;
  --toolbar-bgcolor: var(--om-bg) !important;
  --toolbar-color: var(--om-fg) !important;
  --toolbar-field-background-color: var(--om-bg-dark) !important;
  --toolbar-field-focus-background-color: var(--om-bg-darker) !important;
  --toolbar-field-color: var(--om-fg) !important;
  --toolbar-field-focus-color: var(--om-fg) !important;
  --toolbar-field-border-color: transparent !important;
  --toolbar-field-focus-border-color: var(--om-accent) !important;
  --focus-outline-color: var(--om-accent) !important;
  --tab-selected-bgcolor: var(--om-bg) !important;
  --tab-selected-textcolor: var(--om-fg) !important;
  --tab-hover-background-color: var(--om-bg-dark) !important;
  --tab-loading-fill: var(--om-accent) !important;
  --tab-attention-icon-color: var(--om-accent) !important;
  --chrome-content-separator-color: var(--om-bg-darker) !important;
  --sidebar-background-color: var(--om-bg-dark) !important;
  --sidebar-text-color: var(--om-fg) !important;
  --sidebar-border-color: var(--om-bg-darker) !important;
  --arrowpanel-background: var(--om-bg-dark) !important;
  --arrowpanel-color: var(--om-fg) !important;
  --arrowpanel-border-color: var(--om-sel) !important;
  --panel-separator-color: var(--om-sel) !important;
  --urlbarView-highlight-background: var(--om-sel) !important;
  --urlbarView-highlight-color: var(--om-fg) !important;
  --urlbarView-hover-background: var(--om-bg-light) !important;
  --urlbarView-separator-color: var(--om-sel) !important;
  --link-color: var(--om-accent) !important;
  --color-accent-primary: var(--om-accent) !important;
  --color-accent-primary-hover: var(--om-accent) !important;
  --color-accent-primary-active: var(--om-accent) !important;
  --button-background-color-primary: var(--om-accent) !important;
  --button-text-color-primary: var(--om-bg-darker) !important;
  --toolbarbutton-hover-background: var(--om-bg-light) !important;
  --toolbarbutton-active-background: var(--om-sel) !important;
  --toolbarbutton-icon-fill-attention: var(--om-accent) !important;
  --toolbarbutton-icon-fill: var(--om-fg) !important;
  --lwt-toolbarbutton-icon-fill: var(--om-fg) !important;
  --lwt-toolbar-field-highlight: var(--om-sel) !important;
  --lwt-toolbar-field-highlight-text: var(--om-fg) !important;
  --lwt-tab-line-color: var(--om-accent) !important;
  --lwt-background-tab-separator-color: transparent !important;
  --lwt-additional-images: none !important;
  --lwt-header-image: none !important;
  --input-bgcolor: var(--om-bg-dark) !important;
  --input-color: var(--om-fg) !important;
}

/* Square everything */
*, *::before, *::after,
.tab-background, .tab-content, .toolbarbutton-1, .toolbarbutton-icon, .toolbarbutton-badge-stack,
#urlbar, #urlbar-background, #urlbar-input-container, #searchbar, .urlbarView-row, .urlbarView-row-inner,
.urlbarView-favicon, .identity-box-button, #tracking-protection-icon-container, .urlbar-page-action,
menupopup, panel, .panel-arrowcontent, .menupopup-arrowscrollbox, panelview, menu, menuitem,
.panel-subview-body, .subviewbutton, #notification-popup-box, .popup-notification-panel,
findbar, .findbar-textbox, button, moz-button, input, tooltip, .tab-close-button, .tab-icon-image,
#sidebar-box, #sidebar-main, sidebar-main, .browserContainer, #tabbrowser-tabbox, browser {
  border-radius: 0 !important;
}
:root { --panel-shadow-margin: 0px !important; }
menupopup, panel { --panel-shadow: none !important; }

/* Flat, edge-to-edge tabs; the selected tab gets an accent line like Omarchy's active border */
.tabbrowser-tab { padding-inline: 0 !important; }
/* Tabs 20% shorter than Firefox's default 36px */
:root { --tab-min-height: 29px !important; }
#tabbrowser-tabs, .tabbrowser-tab, .tab-stack, .tab-background, .tab-content,
#tabs-newtab-button, #new-tab-button, #alltabs-button, #TabsToolbar .toolbarbutton-1 {
  min-height: 29px !important;
  max-height: 29px !important;
}
#TabsToolbar .toolbarbutton-1 { padding-block: 0 !important; }
.tab-background {
  margin-block: 0 !important;
  box-shadow: none !important;
  outline: none !important;
  border: none !important;
}
.tabbrowser-tab[selected] .tab-background,
.tabbrowser-tab[multiselected] .tab-background {
  background: var(--om-bg) !important;
  border-top: 2px solid var(--om-accent) !important;
}
.tabbrowser-tab:not([selected]) .tab-label { color: var(--om-fg-light) !important; }
.tab-loading-burst, .tab-throbber { fill: var(--om-accent) !important; }
#TabsToolbar-customization-target { padding-inline-start: 10px !important; }

/* Address bar */
#urlbar[focused] > #urlbar-background, #searchbar:focus-within {
  outline: 1px solid var(--om-accent) !important;
  outline-offset: 0 !important;
}
#urlbar-background, .urlbar-background {
  background-color: var(--om-bg-dark) !important;
  border: 1px solid var(--om-bg-darker) !important;
}
#urlbar[focused] #urlbar-background, #urlbar[open] #urlbar-background,
.urlbar[focused] .urlbar-background, .urlbar[open] .urlbar-background {
  background-color: var(--om-bg-darker) !important;
  outline: 1px solid var(--om-accent) !important;
  outline-offset: 0 !important;
  box-shadow: none !important;
}
.urlbarView, .search-panel-tree, .urlbarView-results { background: transparent !important; color: var(--om-fg) !important; }
#urlbar-searchmode-switcher, .searchmode-switcher { background-color: var(--om-bg-light) !important; }
.urlbarView-row[selected] { background: var(--om-sel) !important; }
.urlbarView-url, .urlbarView-action { color: var(--om-accent) !important; }

/* Popups and menus */
menupopup, panel {
  --panel-background: var(--om-bg-dark) !important;
  --panel-color: var(--om-fg) !important;
  --panel-border-color: var(--om-sel) !important;
}
menupopup > menuitem[_moz-menuactive], menupopup > menu[_moz-menuactive] {
  background-color: var(--om-sel) !important;
  color: var(--om-fg) !important;
}

/* Fonts: Omarchy's monospace for the browser UI */
#urlbar-input, .tab-label, .urlbarView, menupopup, panel, tooltip, #PersonalToolbar, findbar {
  font-family: var(--om-font), monospace !important;
}

/* No gaps or rounded frame around the page */
#tabbrowser-tabbox, .browserContainer, .browserStack, browser {
  margin: 0 !important;
  box-shadow: none !important;
  outline: none !important;
}
#navigator-toolbox { border-bottom: 1px solid var(--om-bg-darker) !important; }

/* The GTK theme paints the toolbars itself; override it directly */
#navigator-toolbox, #titlebar, #TabsToolbar {
  background: var(--om-bg-darker) !important;
  color: var(--om-fg) !important;
}
#nav-bar, #PersonalToolbar, #sidebar-box, #sidebar-main, findbar {
  background: var(--om-bg) !important;
  color: var(--om-fg) !important;
  border: none !important;
  box-shadow: none !important;
}
EOF
)

content_css=$(cat <<EOF
/* Generated by Omarchy (debian/hooks/firefox) — rewritten on every theme/font change. */
@-moz-document url-prefix("about:") {
  :root {
$vars
$square
    color-scheme: $scheme !important;
    --newtab-background-color: var(--om-bg) !important;
    --newtab-background-color-secondary: var(--om-bg-dark) !important;
    --newtab-text-primary-color: var(--om-fg) !important;
    --newtab-primary-action-background: var(--om-accent) !important;
    --in-content-page-background: var(--om-bg) !important;
    --in-content-page-color: var(--om-fg) !important;
    --in-content-box-background: var(--om-bg-dark) !important;
    --in-content-border-color: var(--om-sel) !important;
    --in-content-primary-button-background: var(--om-accent) !important;
    --in-content-primary-button-text-color: var(--om-bg-darker) !important;
    --background-color-canvas: var(--om-bg) !important;
    --background-color-box: var(--om-bg-dark) !important;
    --text-color: var(--om-fg) !important;
    --color-accent-primary: var(--om-accent) !important;
    --link-color: var(--om-accent) !important;
    --focus-outline-color: var(--om-accent) !important;
  }
  *, *::before, *::after { border-radius: 0 !important; }
  body { background-color: var(--om-bg) !important; color: var(--om-fg) !important; }
}
EOF
)

# Every profile listed in profiles.ini
sed -nE 's/^Path=(.*)/\1/p' "$ff/profiles.ini" | while IFS= read -r p; do
  [[ $p == /* ]] || p="$ff/$p"
  [[ -d $p ]] || continue
  mkdir -p "$p/chrome"
  printf '%s\n' "$chrome_css" >"$p/chrome/userChrome.css"
  printf '%s\n' "$content_css" >"$p/chrome/userContent.css"
  # Firefox ignores userChrome.css unless this pref is on
  pref='user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
  touch "$p/user.js"
  sed -i '/toolkit\.legacyUser[A-Za-z]*Customizations\.stylesheets/d' "$p/user.js"
  echo "$pref" >>"$p/user.js"
  sed -i '/"extensions.activeThemeID"/d' "$p/user.js"
  sed -i '/"layout.css.prefers-color-scheme.content-override"/d' "$p/user.js"
done
exit 0
