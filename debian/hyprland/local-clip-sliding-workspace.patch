Description: Clip windows of a sliding workspace to that workspace's slot
 While a workspace slides (workspace switch animation or swipe gesture),
 Hyprland draws all of its windows at their position plus the slide offset,
 without clipping them to the workspace's own area of the monitor. Scrolling
 layout columns that sit off-screen therefore slide in over the neighbouring
 workspace. This skips windows entirely outside the slot and clips the
 surface, border and shadow of the others to it. Only regular (non-special)
 workspaces on their own monitor are affected, and only while the render
 offset is non-zero; nothing changes at rest.
Author: local build (omarchy Debian port)
Bug: https://github.com/hyprwm/Hyprland/issues/15725
Forwarded: no
Last-Update: 2026-11-22
---
--- a/src/render/SlideClip.hpp
+++ b/src/render/SlideClip.hpp
@@ -0,0 +1,33 @@
+#pragma once
+
+// Debian local patch: while a workspace slides (a workspace switch animation or
+// a swipe gesture), clip its windows to that workspace's own slot on the
+// monitor. Without this, scrolling-layout columns that sit off-screen slide
+// into view over the neighbouring workspace.
+
+#include "../Compositor.hpp"
+#include "../desktop/Workspace.hpp"
+#include "../desktop/view/Window.hpp"
+#include "../helpers/Monitor.hpp"
+
+#include <optional>
+#include <hyprutils/utils/ScopeGuard.hpp>
+
+namespace Render {
+    // The clip box (monitor-local, scaled) for a window rendered on pMonitor, or
+    // nothing when its workspace is not sliding there.
+    inline std::optional<CBox> slidingWorkspaceClip(PHLWINDOW pWindow, PHLMONITOR pMonitor) {
+        if (!pWindow || !pMonitor || pWindow->m_pinned)
+            return std::nullopt;
+
+        const auto PWORKSPACE = pWindow->m_workspace;
+        if (!PWORKSPACE || PWORKSPACE->m_isSpecialWorkspace || PWORKSPACE->m_monitor != pMonitor)
+            return std::nullopt;
+
+        const Vector2D OFFSET = PWORKSPACE->m_renderOffset->value();
+        if (OFFSET.x == 0 && OFFSET.y == 0)
+            return std::nullopt;
+
+        return CBox{OFFSET, pMonitor->m_size}.scale(pMonitor->m_scale);
+    }
+}
