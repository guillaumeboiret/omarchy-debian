+    // Debian local patch: a window entirely outside its sliding workspace's slot
+    // (an off-screen scrolling column) is not drawn over the neighbouring one.
+    if (!ignorePosition && !standalone) {
+        if (const auto SLIDECLIP = Render::slidingWorkspaceClip(pWindow, pMonitor); SLIDECLIP) {
+            const auto FULLBOX = pWindow->getFullWindowBoundingBox()
+                                     .translate(-pMonitor->m_position + pWindow->m_workspace->m_renderOffset->value() + pWindow->m_floatingOffset)
+                                     .scale(pMonitor->m_scale);
+            if (FULLBOX.intersection(*SLIDECLIP).empty())
+                return;
+        }
+    }
