#!/bin/bash

# omarchy:summary=Open Voxtype configuration

# Voxtype's settings TUI needs more room than the standard 875x600 float, which
# clipped and rewrapped it, so it gets its own app id and window size
# (default/hypr/apps/system.lua). No shell restart afterwards: the Voxtype bar
# panel reads its state each time it opens.
source omarchy-restart-gum

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.voxtype-config --title="Voxtype Settings" -e voxtype configure
