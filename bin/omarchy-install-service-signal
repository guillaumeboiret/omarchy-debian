#!/bin/bash

# omarchy:summary=Install Signal and launch it.
# omarchy:requires-sudo=true

set -e

echo "Installing Signal..."
omarchy-pkg-add signal-desktop

echo "Opening Signal..."
# Debian port: Signal is a Flatpak whose launcher is ~/.local/bin/signal-desktop.
setsid uwsm-app -- signal-desktop >/dev/null 2>&1 &

echo ""
echo "Signal has been installed."
